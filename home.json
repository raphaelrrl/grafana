      "id": 7,
      "type": "volkovlabs-echarts-panel",
      "title": "TRÁFEGO · LIMPO x ATAQUE (Mbps)",
      "description": "DEMO: séries geradas por random walk. Trocar as queries A/B por dado real.",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 10
      },
      "transparent": false,
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "grafana"
          },
          "queryType": "randomWalk",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "datasource",
            "uid": "grafana"
          },
          "queryType": "randomWalk",
          "refId": "B"
        }
      ],
      "options": {
        "renderer": "canvas",
        "map": "none",
        "editorMode": "code",
        "getOption": "// Business Charts — tráfego limpo x ataque (DEMO com random walk; trocar query por dado real)\nconst ctx = (typeof context !== 'undefined') ? context : null;\nconst frames = ctx ? ctx.panel.data.series : data.series;\nconst vals = (f) => (f && f.values) ? (f.values.toArray ? f.values.toArray() : Array.from(f.values)) : [];\nconst pick = (i) => {\n  const fr = frames[i]; if (!fr) return { t: [], v: [] };\n  const tf = fr.fields.find(x => x.type === 'time'); const vf = fr.fields.find(x => x.type === 'number');\n  return { t: vals(tf), v: vals(vf) };\n};\nconst a = pick(0), b = pick(1);\nconst clean  = a.v.map(v => Math.round(820 + v * 55));\nconst attack = b.v.map(v => Math.max(0, Math.round(140 + v * 45)));\nconst times  = a.t.map(t => new Date(t).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }));\nconst mono = 'ui-monospace, JetBrains Mono, Menlo, Consolas, monospace';\nreturn {\n  backgroundColor: 'transparent',\n  animationDuration: 900, animationEasing: 'cubicOut',\n  textStyle: { fontFamily: mono },\n  legend: { top: 4, right: 8, textStyle: { color: '#8fa3b3', fontSize: 11, fontFamily: mono }, itemWidth: 14, itemHeight: 3, icon: 'rect' },\n  tooltip: { trigger: 'axis', backgroundColor: 'rgba(8,12,18,.95)', borderColor: 'rgba(0,200,255,.35)', textStyle: { color: '#eef4f8', fontFamily: mono, fontSize: 11 }, valueFormatter: v => v + ' Mbps' },\n  grid: { left: 44, right: 14, top: 34, bottom: 26 },\n  xAxis: { type: 'category', data: times, boundaryGap: false, axisLine: { lineStyle: { color: 'rgba(255,255,255,.12)' } }, axisLabel: { color: '#8fa3b3', fontSize: 10 }, axisTick: { show: false } },\n  yAxis: { type: 'value', splitLine: { lineStyle: { color: 'rgba(255,255,255,.06)' } }, axisLabel: { color: '#8fa3b3', fontSize: 10, formatter: '{value}' } },\n  series: [\n    { name: 'TRÁFEGO LIMPO', type: 'line', data: clean, smooth: true, showSymbol: false,\n      lineStyle: { width: 2, color: '#00c8ff', shadowColor: 'rgba(0,200,255,.6)', shadowBlur: 12 },\n      areaStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: 'rgba(0,200,255,.35)' }, { offset: 1, color: 'rgba(0,200,255,0)' }] } } },\n    { name: 'ATAQUE MITIGADO', type: 'line', data: attack, smooth: true, showSymbol: false,\n      lineStyle: { width: 2, color: '#ff5a5a', shadowColor: 'rgba(255,90,90,.6)', shadowBlur: 12 },\n      areaStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: 'rgba(255,90,90,.35)' }, { offset: 1, color: 'rgba(255,90,90,0)' }] } } }\n  ]\n};\n",
        "editor": {

        "styles": ":root{--fs-accent:#00c8ff;--fs-alert:#ff5a5a;--fs-text:#eef4f8;--fs-dim:#8fa3b3;--fs-line:rgba(255,255,255,.08);\n--fs-mono:ui-monospace,\"JetBrains Mono\",Menlo,Consolas,monospace;}\n.fs-banner{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:var(--fs-mono);color:var(--fs-dim);padding:6px 4px 10px;border-bottom:1px solid var(--fs-line);}\n.fs-banner-left{display:flex;align-items:center;gap:12px;font-size:12px;letter-spacing:.04em;}\n.fs-banner-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}\n.fs-prompt{color:var(--fs-accent);}.fs-path{color:var(--fs-text);margin-left:6px;}.fs-sep{opacity:.35;}\n.fs-title{color:var(--fs-text);font-weight:700;letter-spacing:.14em;font-size:13px;}.fs-thin{font-weight:400;color:var(--fs-dim);}\n.fs-pill{display:inline-flex;align-items:center;gap:8px;padding:5px 12px;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:var(--fs-text);font-family:var(--fs-mono);font-size:11px;letter-spacing:.12em;text-decoration:none;background:rgba(8,12,18,.6);}\n.fs-pill--ok{border-color:rgba(0,200,255,.35);background:rgba(0,200,255,.12);}\n.fs-pill--alert{border-color:rgba(255,90,90,.45);background:rgba(255,90,90,.12);color:#ffd5d5;}\n.fs-pill--alert:hover{background:rgba(255,90,90,.25);}\n.fs-dot{width:7px;height:7px;border-radius:50%;background:var(--fs-accent);animation:fs-pulse 1.8s ease-out infinite;}\n@keyframes fs-pulse{0%{box-shadow:0 0 0 0 rgba(0,200,255,.55)}100%{box-shadow:0 0 0 9px rgba(0,200,255,0)}}\n.fs-ticker{overflow:hidden;white-space:nowrap;margin-top:8px;font-family:var(--fs-mono);font-size:11px;letter-spacing:.16em;color:var(--fs-dim);}\n.fs-ticker-track{display:inline-block;animation:fs-scroll 40s linear infinite;}\n.fs-ticker-track span{margin-right:42px;}.fs-ticker-track span::first-letter{color:var(--fs-accent);}\n@keyframes fs-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n",

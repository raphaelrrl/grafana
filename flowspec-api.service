[Unit]
Description=Flowspec FlowSpec API (dashboard de mitigacao)
After=network.target gobgpd.service

[Service]
Type=simple
# Token: gere com  openssl rand -hex 24  e cole abaixo e na variavel 'token' do dashboard
Environment=TOKEN=TROQUE-O-TOKEN
Environment=BIND=127.0.0.1
Environment=PORT=8765
Environment=STATE=/var/lib/flowspec/c2flowspec.json
Environment=WLFILE=/var/lib/flowspec/whitelist.json
ExecStart=/usr/bin/python3 /root/flowspec-api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

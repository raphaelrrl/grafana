                "content": "<!DOCTYPE html>\n<html lang=\"pt-br\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Flowbix Banner</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap\" rel=\"stylesheet\">\n  <style>\n    .container-banner-unique {\n      height: 100%;\n    }\n\n    .content-wrapper-banner-unique {\n      width: 100%;\n      margin: 0;\n    }\n\n    .background-banner-unique {\n      height: 100%;\n      margin: 0;\n    }\n\n    .input-wrapper-banner-unique {\n      background: rgba(0, 0, 0, 0.2);\n      width: 100%;\n      height: 100%;\n      border: 0;\n      color: #FFFFFF;\n    }\n\n    .main-container-banner-unique {\n      background: rgba(0, 0, 0, 0.1);\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      height: 100%;\n      position: relative;\n      border-radius: 5rem;\n      border: 1px solid rgba(204, 204, 220, 0.12);\n    }\n\n    .content-main-banner-unique {\n      display: flex;\n      align-items: center;\n      gap: 1rem;\n      color: #FFFFFF;\n      font-weight: 400;\n      font-size: 1.5rem;\n      text-transform: uppercase;\n    }\n\n    .logo-banner-unique {\n      height: 4rem;\n      width: auto;\n    }\n\n    .text-banner-unique {\n      font-size: 2rem;\n      color: #FFFFFF;\n      text-align: center;\n      display: flex;\n      align-items: center;\n      gap: 0.5rem;\n    }\n\n    .divider-text-unique {\n      color: #FFFFFF;\n      font-size: 2rem;\n    }\n\n    .icon-security-unique {\n      width: 2rem;\n      height: auto;\n    }\n  </style>\n</head>\n\n<body>\n  <!-- Estrutura do banner -->\n  <div class=\"main-container-banner-unique\">\n    <div class=\"content-main-banner-unique\">\n      <span class=\"text-banner-unique\"> INCIDENTES\n\n        <!-- Ícone de segurança embutido ao lado do texto -->\n        <img src=\"https://img.icons8.com/?size=100&id=8122&format=png&color=FFFFFF\" alt=\"Security Icon\" class=\"icon-security-unique\">\n      </span>\n    </div>\n  </div>\n</body>\n\n</html>",
                "mode": "html"
              },
              "fieldConfig": {
                "defaults": {},

                  "height": 600
                },
                "editorMode": "visual",
                "gaode": {
                  "key": "",
                  "plugin": "AMap.Scale,AMap.ToolBar"
                },
                "getOption": "let values = [];\ndata.series.forEach((s) => {\n  const numberFields = s.fields.filter((f) => f.type === 'number');\n  numberFields.forEach((field) => {\n    values.push(field.values);\n  });\n});\n\nreturn {\n  legend: {\n    top: 'bottom'\n  },\n  toolbox: {\n    show: false,\n    feature: {\n      mark: { show: true },\n      dataView: { show: true, readOnly: false },\n      restore: { show: true },\n      saveAsImage: { show: true }\n    }\n  },\n  series: [\n    {\n      name: 'Nightingale Chart',\n      type: 'pie',\n      radius: [50, 250],\n      center: ['50%', '50%'],\n      roseType: 'area',\n      itemStyle: {\n        borderRadius: 8\n      },\n      data: [\n        { value: values[0], name: 'Switch Huawei', itemStyle: { color: '#99c2ff' } },\n        { value: values[1], name: 'BGP', itemStyle: { color: '#3385ff' } },\n        { value: values[2], name: 'OLTS', itemStyle: { color: '#005ce6' } },\n        { value: values[3], name: 'Switch Datacom', itemStyle: { color: '#0052cc' } },\n        { value: values[4], name: 'Concentrador', itemStyle: { color: '#003d99' } }\n      ]\n    }\n  ]\n};",
                "google": {
                  "callback": "gmapReady",
                  "key": ""
                },
                "map": "none",
                "renderer": "canvas",
                "themeEditor": {
                  "config": "{}",
                  "height": 400,
                  "name": "default"
                },
                "visualEditor": {
                  "code": "// Pega a fonte de dados que o Grafana fornece\nconst seriesData = context.panel.data.series[0];\n\n// Array para armazenar os dados do gráfico de pizza\nconst pieData = [];\n\n// Mapeia as severidades para suas cores e ordem padrão do Zabbix\nconst severityMap = {\n  'Disaster': { color: '#DC3838', order: 5 },\n  'High': { color: '#FF991A', order: 4 },\n  'Average': { color: '#F3DA91', order: 3 },\n  'Warning': { color: '#F9DB25', order: 2 },\n  'Information': { color: '#33A2CC', order: 1 },\n  'Not classified': { color: '#A9A9AA', order: 0 }\n};\n\n// Objeto para armazenar a SOMA total de cada severidade\nconst severityTotals = {\n  'Disaster': 0, 'High': 0, 'Average': 0, 'Warning': 0,\n  'Information': 0, 'Not classified': 0\n};\n\nlet titleText = 'Problemas por Severidade';\n\n// ===== LÓGICA ATUALIZADA PARA SOMAR TODAS AS LINHAS =====\nif (seriesData && seriesData.fields.length > 0) {\n  // Itera sobre cada nome de severidade que nos interessa\n  for (const severityName in severityTotals) {\n    const field = seriesData.fields.find(f => f.name === severityName);\n\n    if (field) {\n      // SOMA todos os valores nesta coluna (para todas as linhas/grupos)\n      const columnTotal = field.values.toArray().reduce((sum, value) => sum + value, 0);\n      severityTotals[severityName] = columnTotal;\n    }\n  }\n\n  // Constrói os dados do gráfico a partir dos totais somados\n  for (const severityName in severityTotals) {\n    const totalValue = severityTotals[severityName];\n    if (totalValue > 0) {\n      const severityInfo = severityMap[severityName];\n      pieData.push({\n        name: severityName,\n        value: totalValue,\n        itemStyle: { color: severityInfo.color },\n        order: severityInfo.order\n      });\n    }\n  }\n\n  // Ajusta o título dinamicamente\n  const rowCount = seriesData.fields[0].values.length;\n  if (rowCount > 1) {\n    titleText += ' - Todos os Grupos';\n  } else {\n    const groupField = seriesData.fields.find(f => f.name === 'Host group');\n    if (groupField) {\n      const groupName = groupField.values.get(0);\n      titleText += ` - ${groupName}`;\n    }\n  }\n}\n// =========================================================\n\n// Ordena as fatias pela ordem de severidade\npieData.sort((a, b) => b.order - a.order);\n\n// Verificação para o caso de não haver alarmes\nif (pieData.length === 0) {\n  return {\n    backgroundColor: 'transparent',\n    title: {\n      text: 'SEM ALARMES',\n      left: 'center', top: 'center',\n      textStyle: { color: '#00E96A', fontSize: 24, fontWeight: 'bold' }\n    }\n  };\n}\n\n// Configuração do Gráfico de Pizza\nreturn {\n  backgroundColor: 'transparent',\n  title: {\n    text: titleText,\n    left: 'center', top: '2%',\n    textStyle: { color: '#FFFFFF', fontSize: 20, fontWeight: 'bold' }\n  },\n  tooltip: {\n    trigger: 'item',\n    formatter: '{b}: {c} ({d}%)'\n  },\n  legend: {\n    orient: 'horizontal', type: 'scroll', bottom: '5%',\n    data: pieData.map((item) => item.name),\n    textStyle: { color: '#FFFFFF', fontSize: 12, fontWeight: 'bold' },\n    pageTextStyle: { color: '#FFFFFF' },\n    pageIconColor: '#FFFFFF',\n    pageIconInactiveColor: '#CCCCCC'\n  },\n  series: [{\n    name: 'Problemas por Severidade',\n    type: 'pie',\n    roseType: 'area',\n    radius: ['15%', '50%'],\n    center: ['50%', '50%'],\n    data: pieData,\n    label: {\n      show: true,\n      formatter: '{b}\\n{c}',\n      color: '#FFFFFF', fontSize: 14, fontWeight: 'bold'\n    },\n    labelLine: {\n      length: 15, length2: 10,\n      lineStyle: { color: '#FFFFFF', width: 2 }\n    },\n    itemStyle: {\n      borderRadius: 15,\n      borderColor: 'rgba(0,0,0,1)',\n      borderWidth: 1.5,\n    }\n  }]\n};",
                  "dataset": [
